{
  "model": "opus",
  "permissions": {
    "additionalDirectories": ["~/.cargo/registry"],
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm secrets:scan:*)",
      "Bash(pnpm knip:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue view:*)",
      "Bash(ls:*)",
      "Bash(node \"/home/juha/.claude/plugins/cache/openai-codex/codex/1.0.4/scripts/codex-companion.mjs\" review:*)",
      "Bash(node \"/home/juha/.claude/plugins/cache/openai-codex/codex/1.0.4/scripts/codex-companion.mjs\" result:*)",
      "Bash(node \"/home/juha/.claude/plugins/cache/openai-codex/codex/1.0.4/scripts/codex-companion.mjs\" status:*)",
      "Read(~/.claude/plugins/cache/openai-codex/**)",
      "Read(~/.claude/commands/**)",
      "Edit(**/.plans/**)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git worktree add .worktrees/*)",
      "Bash(git worktree list:*)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(rustup toolchain list:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo +1.95.0 fmt:*)",
      "Bash(cargo +1.95.0 clippy:*)",
      "Bash(pkg-config:*)",
      "Bash(which:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(readlink:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/allow-worktree-commands.ts"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "git",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen"
}
